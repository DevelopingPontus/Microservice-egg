      "title": "Attention Thrashing (Context Switch Rate & Shannon Entropy)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "egg_user_shannon_entropy_nats",
          "legendFormat": "Entropy (nats)"
        },
        {
          "expr": "egg_user_context_switches_per_min",
          "legendFormat": "Switches / min"
        }
      ]
    },
    {
      "id": 6,
      "title": "Psychomotor Quality & Jitter (Correction Ratio & IKI CV)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "egg_user_correction_ratio",
          "legendFormat": "Correction Ratio"
        },
        {
          "expr": "egg_user_iki_jitter_cv_ratio or egg_user_iki_jitter_cv",
          "legendFormat": "Typing Cadence CV (Jitter)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
