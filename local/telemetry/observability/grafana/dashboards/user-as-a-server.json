    {
      "id": 1,
      "title": "Active Work Time (Stat + Sparkline)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "egg_user_active_work_seconds",
          "legendFormat": "Active Work",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#5794F2", "value": null },
              { "color": "#73BF69", "value": 1800 }
            ]
          }
        }
      },
      "description": "Cumulative active work time including <=3m reading/thought grace."
    },
    {
      "id": 2,
      "title": "Continuous Session Uptime (Stat)",
      "type": "stat",
