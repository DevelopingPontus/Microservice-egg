# Personal Sprint Reports, Walkthroughs & LinkedIn Slides (local-only)
reports/

# Environment variables & secrets (never commit API keys or DB credentials)
.env
.env.*
!.env.example

# Python & uv environments (local/agent/)
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Python tool caches & coverage artifacts
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local SQLite databases & WAL files (never commit telemetry data)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Java / Spring Boot / Maven / Gradle (server/)
target/
.gradle/
build/
!**/src/**/build/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Frontend / Node (local/ui/)
node_modules/
.next/
.vite/
.svelte-kit/
out/
.npm
.eslintcache
*.tsbuildinfo

# Logs & runtime state
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock
tmp/
temp/

# OS & Editor files
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*.swo
*~

# Local PDF documents & design briefs
*.pdf
